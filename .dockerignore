# Never ship secrets or local state into the image.
.env
.env.*
*.local
.clerk
.data

# Rebuilt inside the image.
**/node_modules
**/dist
**/*.tsbuildinfo

# The Mac app's local builds (only release/ goes into the image): ~1 GB after `swift build`.
apps/dictate-mac/.build
apps/dictate-mac/build

# Not needed to build, and changes to them shouldn't bust the install cache.
.git
.github
.claude
docs
e2e
coverage
playwright-report
test-results
**/.DS_Store
