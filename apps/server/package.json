{
  "name": "@hearth/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts"
    }
  },
  "scripts": {
    "dev": "NODE_ENV=development AUTH_MODE=${AUTH_MODE:-dev} HOST_KIND=${HOST_KIND:-local} DATA_DIR=${DATA_DIR:-../../.data} tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json && mkdir -p dist/meetings/templates && cp src/meetings/templates/*.md dist/meetings/templates/",
    "start": "NODE_ENV=${NODE_ENV:-production} node dist/main.js",
    "reindex": "NODE_ENV=${NODE_ENV:-development} AUTH_MODE=${AUTH_MODE:-dev} HOST_KIND=${HOST_KIND:-local} DATA_DIR=${DATA_DIR:-../../.data} tsx src/cli/reindex.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "@clerk/backend": "^3.23.1",
    "@hearth/format": "workspace:*",
    "@hono/node-server": "^1.19.17",
    "@hono/node-ws": "^1.3.1",
    "@hono/zod-validator": "^0.9.1",
    "@ironcalc/wasm": "0.9.1",
    "@joplin/turndown-plugin-gfm": "^1.0.71",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@mozilla/readability": "^0.6.0",
    "aws4fetch": "1.0.20",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.6",
    "fflate": "0.8.3",
    "hono": "^4.13.13",
    "linkedom": "^0.18.12",
    "sqlite-vec": "^0.1.9",
    "turndown": "^7.2.5",
    "ulid": "^3.0.2",
    "unpdf": "2.1.0",
    "web-push": "3.6.7",
    "ws": "^8.22.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/turndown": "^5.0.6",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2"
  }
}
