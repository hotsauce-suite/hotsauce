// The hotsauce.work website: static pages on Cloudflare Workers. Deploy with `npx wrangler deploy` from this folder.
// Each deploy first builds the live demo (docs/PLAN-live-demo.md) into public/demo/.
{
  "name": "hotsauce-site",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  // Wrangler runs this from wherever it was started, so it finds the repo root itself, and
  // stops the deploy if it isn't run inside the repository.
  "build": {
    "command": "root=$(git rev-parse --show-toplevel) && cd \"$root\" && pnpm install --frozen-lockfile && pnpm build:format && pnpm --filter @hearth/web build:demo"
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./public",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "hotsauce.work", "custom_domain": true },
    { "pattern": "www.hotsauce.work", "custom_domain": true },
    { "pattern": "demo.hotsauce.work", "custom_domain": true }
  ]
}
