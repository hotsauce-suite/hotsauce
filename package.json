{
  "name": "hotsauce",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:format": "pnpm --filter @hearth/format build",
    "dev": "pnpm build:format && pnpm -r --parallel --filter @hearth/format --filter @hearth/server --filter @hearth/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "pnpm build:format && vitest run",
    "test:unit": "pnpm build:format && vitest run --project format --project server-unit --project web --project extension",
    "test:integration": "pnpm build:format && vitest run --project server-integration",
    "test:e2e": "pnpm build:format && playwright test",
    "test:all": "pnpm test && pnpm test:e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
